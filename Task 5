import random

secret_number = random.randint(1, 100)
max_attempts = 7
valid_attempts = 0

print("Welcome to the Number Guessing Game!")
print("I have picked a secret number between 1 and 100. You have 7 attempts.")

while valid_attempts < max_attempts:
    guess = int(input("\nEnter your guess (1-100): "))

    # Reject guesses outside 1-100 without counting them
    if guess < 1 or guess > 100:
        print("Invalid guess! Please enter a number between 1 and 100 (this does not count as an attempt).")
        continue

    valid_attempts += 1

    if guess == secret_number:
        if valid_attempts == 1:
            print("PERFECT SCORE! Incredible—you guessed it on your very first try!")
        else:
            print(f"Congratulations! You guessed the secret number in {valid_attempts} attempts!")
        break
    elif guess < secret_number:
        print(f"The secret number is HIGHER. Attempts left: {max_attempts - valid_attempts}")
    else:
        print(f"The secret number is LOWER. Attempts left: {max_attempts - valid_attempts}")

else:
    print(f"\nOut of attempts! The secret number was {secret_number}.")
