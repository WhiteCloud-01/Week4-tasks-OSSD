while True:
    n = int(input("Enter a positive integer: "))
    if n > 0:
        break
    print("Invalid input! Please enter a number greater than 0.")

print("\n--- Standard Number Pattern ---")
for i in range(1, n + 1):
    for j in range(1, i + 1):
        print(j, end="")
    print()

print("\n--- Inverted Number Pattern ---")
for i in range(n, 0, -1):
    for j in range(1, i + 1):
        print(j, end="")
    print()

print(f"\n--- Multiplication Table (1 to {n}) ---")
for i in range(1, n + 1):
    for j in range(1, 11):
        print(f"{i} x {j} = {i * j}")
    print()
