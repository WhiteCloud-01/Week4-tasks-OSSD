total_marks = 0
highest_mark = -1
passed_count = 0
failed_count = 0

for student in range(1, 11):
    while True:
        mark = float(input(f"Enter marks for student {student} (0-100): "))
        if 0 <= mark <= 100:
            break
        else:
            print("Invalid mark! Please enter a number between 0 and 100.")

    # Assign grade
    if mark >= 90:
        grade = "A"
    elif mark >= 80:
        grade = "B"
    elif mark >= 70:
        grade = "C"
    elif mark >= 60:
        grade = "D"
    else:
        grade = "F"

    print(f"Student {student} Grade: {grade}")

    # Count pass and fail
    if mark >= 50:
        passed_count += 1
    else:
        failed_count += 1

    # Track highest mark and total
    if mark > highest_mark:
        highest_mark = mark

    total_marks += mark

average = total_marks / 10

print("\n--- Class Results ---")
print(f"Passed: {passed_count}")
print(f"Failed: {failed_count}")
print(f"Highest Mark: {highest_mark}")
print(f"Class Average: {average:.2f}")
